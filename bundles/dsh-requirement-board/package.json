{
  "name": "dsh-requirement-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-session requirement board: shared requirement records, custom flow templates, node transitions, a flow-chart Web panel, and agent tools.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./role": "./role.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "role.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "locale",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "DESIGN.md",
    "ROLE-DISPATCH.md",
    "EXTENDING.md",
    "OPTIMIZATION.md",
    "G-CHECKLIST.md",
    "LEAD-DECISIONS.md",
    "R-ROLLOUT.md",
    "评审文档.md",
    "tests",
    "probes",
    "dev"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-alpha.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-json": "0.2.1-alpha.1",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
